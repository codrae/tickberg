{
  "id": 2,
  "uid": "tickberg-1b",
  "title": "tickberg — 1B 풍부화 패널",
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "type": "timeseries",
      "title": "KIS publish rate per symbol (msg/s, 1m avg)",
      "description": "장 시간대 평균 30–50/sec, 피크 ~250/sec. 종목별 burst 분포 확인.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (symbol) (rate(kis_messages_published_total[1m]))",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10}
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 11,
      "type": "stat",
      "title": "WebSocket connected",
      "description": "영업시간만 1. 마감 후 0 정상.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "kis_ws_connected", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "none"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Token refresh failures (24h)",
      "description": "03:30 KST 정기 갱신 + on-demand. 04:30 cutoff 전 0 유지 기대.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "increase(kis_token_refresh_failures_total[24h])", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 3}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "none"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Kafka topic 'kis.tick.raw' broker-side in rate (msg/s)",
      "description": "producer → broker 흡수율. KIS publish rate 와 ~동기 — 차이 크면 backlog 의심.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "kafka_topic_messagesinpersec_rate{topic=\"kis.tick.raw\"}",
          "legendFormat": "broker in/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 10}}
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Parse errors (1h)",
      "description": "KIS payload 포맷 변경 또는 producer 버그 감지. 5 이상 노란, 50 이상 빨간.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "increase(kis_parse_errors_total[1h])", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 50}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "none"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8}
    },
    {
      "id": 20,
      "type": "row",
      "title": "KRaft Health",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16},
      "panels": []
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Active Controller (1=healthy)",
      "description": "KRaft 모드에서 controller quorum 정상 시 1. !=1 이면 controller election 실패.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "kafka_controller_activecontrollercount", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1},
              {"color": "red", "value": 2}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "none"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 17}
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Active Broker (1=healthy)",
      "description": "현재 단일 broker 구성. 0 이면 broker down — KIS 흐름 전면 중단.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "kafka_controller_activebrokercount", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "none"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 17}
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Offline Partitions (0=healthy)",
      "description": "0 유지 필요. >0 이면 producer publish 실패 또는 consumer 읽기 차단.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "kafka_controller_offlinepartitionscount", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "none"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 17}
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Metadata Apply Lag (ms)",
      "description": "Controller 가 metadata record 를 적용한 시점 lag. KRaft 내부 health 지표.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "kafka_controller_lastappliedrecordlagms", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5000},
              {"color": "red", "value": 30000}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "none"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 17}
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Controller 이벤트 추세 (errors / heartbeat timeouts)",
      "description": "정상 시 두 라인 모두 0 평탄. >0 누적이면 controller pressure 의심.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "kafka_controller_metadataerrorcount", "legendFormat": "metadata errors", "refId": "A"},
        {"expr": "kafka_controller_timedoutbrokerheartbeatcount", "legendFormat": "broker heartbeat timeouts", "refId": "B"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10}}
      },
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 21}
    },
    {
      "id": 30,
      "type": "row",
      "title": "Spark Streaming (Bronze)",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27},
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Bronze batch latency (ms)",
      "description": "Trigger=1min. latency 가 60000ms 미만이면 trigger interval 안에 처리 완료 = lag 없음. queryName=bronze_kis_tick_streaming.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "{__name__=~\"metrics_app_.*_driver_spark_streaming_bronze_kis_tick_streaming_latency_Value\"}",
          "legendFormat": "batch latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {"drawStyle": "line", "fillOpacity": 10},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 30000},
              {"color": "red", "value": 60000}
            ]
          }
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28}
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Spark input vs processing rate (rows/s)",
      "description": "두 라인 거의 일치해야 정상. inputRate >> processingRate 이면 lag 누적 시작. 휴장 시 두 값 모두 0.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "{__name__=~\"metrics_app_.*_driver_spark_streaming_bronze_kis_tick_streaming_inputRate_total_Value\"}",
          "legendFormat": "input rows/s",
          "refId": "A"
        },
        {
          "expr": "{__name__=~\"metrics_app_.*_driver_spark_streaming_bronze_kis_tick_streaming_processingRate_total_Value\"}",
          "legendFormat": "processed rows/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 10}}
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28}
    }
  ]
}
