cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Spark / Hadoop
spark-warehouse/
derby.log
metastore_db/
*.crc

# 데이터 파일 (Bronze raw 등은 절대 커밋 X)
*.parquet
*.csv
*.tsv
*.xlsx
*.xls
data/
raw_data/
warehouse/
minio_data/

# 환경변수·시크릿 (한투 API 키, AWS 키 등 절대 커밋 X)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# AWS / Terraform
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude
.claude/cache/
EOF